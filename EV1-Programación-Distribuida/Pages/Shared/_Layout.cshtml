<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cassette</title>
    <link rel="shortcut icon" href="~/images/Cassette favicon.png" type="image/x-icon">

    <script type="importmap"></script>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EV1_Programación_Distribuida.styles.css" asp-append-version="true" />
    
    <!-- CSS -->
    <link rel="stylesheet" href="~/css/login.css">
    <link rel="stylesheet" href="~/css/regueton.css">

    <!-- Google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">

    <!-- Bootstrap iconos -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom box-shadow">
            <!-- Menú desktop -->
            <div class="container position-relative pt-3 pb-3">
                <div class="d-none d-md-flex">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-page="/Home">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Temas">Temas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Nosotros">Nosotros</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Contacto">Contacto</a></li>
                    </ul>
                </div>

                <a class="navbar-brand position-absolute" style="left: 50%; transform: translateX(-50%);" asp-page="/Home">
                   <img src="~/images/Cassette logo.png" height="50" />
                </a>

                <button class="navbar-toggler d-md-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMobile" aria-controls="navbarMobile" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <a class="btn-casual d-none d-md-block" href="https://github.com/FrancoLoera/EV1-Programacion-Distribuida" target="_blank">
                    Ver repositorio<i class="bi bi-github ms-1"></i>
                </a>
            </div>

            <!-- Menú mobile -->
            <div class="collapse d-md-none" id="navbarMobile">
                <div class="container">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" asp-page="/Home">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Temas">Temas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Nosotros">Nosotros</a></li>
                        <li class="nav-item"><a class="nav-link" asp-page="/Contacto">Contacto</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-5 pt-5 ps-3 pe-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted pt-2 pb-2">
        <div class="container">
            &copy; 2026 - Cassette
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
