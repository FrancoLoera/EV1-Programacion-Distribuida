@page
@model EV1_Programación_Distribuida.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.css" rel="stylesheet" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/login.css">

    <!-- Google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">

    <title>Inicio de sesión - Cassette</title>
</head>
<body>
    <main class="section vh-100 d-flex align-items-center">
        <section class="container">
            <div class="row justify-content-center">
                <div class="col-4 d-flex flex-column justify-content-center">
                    <img src="~/images/Cassette logo.png" height="90" class="pb-5 align-self-start"/>

                    <h1>Inicio de sesión</h1>
                    <p class="mb-4">
                        Inicia sesión y descubre nuevas historias, artistas y momentos que hacen de la música algo especial.
                    </p>

                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Usuario</label>
                            <input class="form-input" type="text" placeholder="Escribe tu usuario"/>
                        </div>

                        <div class="mb-3">
                            <label for="password" class="form-label fw-bold">Contraseña</label>
                            <input id="txtPassword" class="form-input" type="password" placeholder="Escribe tu contraseña"/>
                        </div>

                        <div class="mb-4 form-check">
                            <input type="checkbox" class="form-check-input" id="chkRemember">
                            <label class="form-check-label" for="chkRemember">Recordarme</label>
                        </div>

                        <a asp-page="/Home" class="btn-casual">
                            Ingresar
                        </a>
                    </form>

                    <p class="mt-3">¿No tienes una cuenta? <a asp-page="/SignUp" class="fw-bold text-decoration-underline">Regístrate</a></p>
                </div>
                <div class="col-6 d-flex align-items-center justify-content-end">
                    <img src="~/images/Cassette form img 1.png" class="w-75"/>
                </div>
            </div>
        </section>
    </main>
</body>
</html>