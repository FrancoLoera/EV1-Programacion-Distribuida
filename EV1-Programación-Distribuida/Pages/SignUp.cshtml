@page
@model EV1_Programación_Distribuida.Pages.SignUpModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es" translate="no">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.rtl.css" rel="stylesheet" />
    <link href="~/lib/bootstrap/dist/css/bootstrap-grid.css" rel="stylesheet" />

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/sign-up.css">

    <!-- Google fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">

    <title>Inicio de sesión - Cassette</title>
</head>
<body>
    <main class="section vh-100 d-flex align-items-center">
        <section class="container">
            <div class="row justify-content-center">
                <div class="col-6 d-flex align-items-center justify-content-center">
                    <img src="~/images/Cassette form img 3.png" class="w-75" />
                </div>
                <div class="col-6 d-flex flex-column justify-content-center">
                    <img src="~/images/Cassette logo white.png" height="90" class="pb-5 align-self-start" />

                    <h1>Crea tu cuenta</h1>
                    <p class="mb-4">
                        Crea tu cuenta y comienza a descubrir nuevas historias, artistas y experiencias alrededor de la música.
                    </p>

                    <form method="post">
                        <div class="row mb-3">
                            <div class="col-6">
                                <label for="txtUsername" class="form-label fw-bold">Usuario</label>
                                <input id="txtUsername" class="form-input" type="text" placeholder="Escribe tu usuario"/>
                            </div>
                            <div class="col-6">
                                <label for="txtUsername" class="form-label fw-bold">Nombre</label>
                                <input id="txtUsername" class="form-input" type="text" placeholder="Escribe tu nombre"/>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="txtPassword" class="form-label fw-bold">Contraseña</label>
                            <input id="txtPassword" class="form-input" type="password" placeholder="Escribe tu contraseña"/>
                        </div>

                        <div class="mb-3">
                            <label for="txtPasswordConfirmation" class="form-label fw-bold">Confirmar contraseña</label>
                            <input id="txtPasswordConfirmation" class="form-input" type="password" placeholder="Repite tu contraseña"/>
                        </div>

                        <div class="mb-4">
                            <label for="ddlUserRole" class="form-label fw-bold">Tipo de cliente</label>
                            <select class="form-dropdown" id="ddlUserRole">
                                <option value="0">Seleccione</option>
                                <option value="1">Lector</option>
                                <option value="2">Autor</option>
                            </select>
                        </div>

                        <a asp-page="Login" class="btn-casual">
                            Registrar
                        </a>
                    </form>

                    <p class="mt-3">Si ya tienes una cuenta <a asp-page="Login" class="fw-bold text-decoration-underline">Inicia sesión</a></p>
                </div>
            </div>
        </section>
    </main>
</body>
</html>