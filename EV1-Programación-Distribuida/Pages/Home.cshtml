@page
@model EV1_Programación_Distribuida.Pages.HomeModel
@{
    Layout = "_Layout";
}
<section id="hero-section" class="d-flex flex-column align-items-center justify-content-center pb-5 mb-5">
    <div class="text-center">
        <img src="~/images/Fondo abstracto panorámico.png" class="rounded-3 shadow" style="width: 55%"/>
    </div>

    <div class="w-50 mt-4 d-flex flex-column align-items-center">
        <h1 class="align-self-center text-center">Tu música, en un solo Cassette.</h1>
        <p class="text-center">Explora historias, artistas, álbumes y géneros que han dejado huella en la música. Rebobina, descubre y encuentra algo nuevo para escuchar.</p>
        <a class="btn-casual" asp-page="/Temas">
            Explorar temas
        </a>
    </div>
</section>
<section id="feed-section" class="d-flex flex-column align-items-center justify-content-center rounded shadow p-5" style="background-color: #F8F8F8;">
    <i class="bi bi-music-note-beamed fs-1"></i>
    <h2>Descubre algo para escuchar</h2>
    <p class="mb-4">Explora nuestras últimas publicaciones y encuentra algo que encaje contigo.</p>

    <!-- Primer fila feed -->
    <div class="row mb-4">
        <div class="col-6">
            <a asp-page="/Pop">
                <div class="custom-card" >
                    <div class="card-img-container">
                        <img src="~/images/Pop/pop1.jpg" style="width: 100%">
                    </div>
                    <div class="custom-card-body">
                        <h5 class="card-title">Pop</h5>
                        <div class="card-meta d-flex mt-2 mb-2">
                            <p class="mb-0"><i class="bi bi-person-fill ms-0 me-1"></i>Román</p>
                            <p class="mb-0"><i class="bi bi-bookmark-fill ms-3 me-1"></i>Pop</p>
                        </div>
                        <p class="card-text">La música Pop, es un género musical orientado principalmente a llegar a un público amplio. Se caracteriza por utilizar melodías...</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-6">
            <a asp-page="/Salsa">
                <div class="custom-card" >
                    <div class="card-img-container">
                        <img src="~/images/Salsa/salsa1.jpg" style="width: 100%">
                    </div>
                    <div class="custom-card-body">
                        <h5 class="card-title">Salsa. Ritmo, identidad y movimiento</h5>
                        <div class="card-meta d-flex mt-2 mb-2">
                            <p class="mb-0"><i class="bi bi-person-fill ms-0 me-1"></i>Omar</p>
                            <p class="mb-0"><i class="bi bi-bookmark-fill ms-3 me-1"></i>Salsa</p>
                        </div>
                        <p class="card-text">La salsa es un género musical bailable que reúne diferentes influencias de la música afrocaribeña y latinoamericana...</p>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- Segunda fila feed -->
    <div class="row mb-5">
        <div class="col-6">
            <article>
                <a asp-page="/Rock">
                    <div class="custom-card">
                        <div class="card-img-container">
                            <img src="~/images/Rock/Rock.webp" style="width: 100%">
                        </div>
                        <div class="custom-card-body">
                            <h5 class="card-title">La Evolución y la Fuerza del Rock en Español</h5>
                            <div class="card-meta d-flex mt-2 mb-2">
                                <p class="mb-0"><i class="bi bi-person-fill ms-0 me-1"></i>Alan</p>
                                <p class="mb-0" asp-page="/Home"><i class="bi bi-bookmark-fill ms-3 me-1"></i>Rock</p>
                            </div>
                            <p class="card-text">El rock en español no es simplemente una adaptación del rock anglosajón; es un movimiento cultural con...</p>
                        </div>
                    </div>
                </a>
            </article>
        </div>
        <div class="col-6">
            <article>
                <a href="#">
                    <div class="custom-card">
                        <div class="card-img-container">
                            <img src="~/images/Fondo abstracto.png" style="width: 100%">
                        </div>
                        <div class="custom-card-body">
                            <h5 class="card-title">Conociendo al Electro Pop</h5>
                            <div class="card-meta d-flex mt-2 mb-2">
                                <p class="mb-0"><i class="bi bi-person-fill ms-0 me-1"></i>Román</p>
                                <p class="mb-0" asp-page="/Home"><i class="bi bi-bookmark-fill ms-3 me-1"></i>Pop</p>
                            </div>
                            <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                        </div>
                    </div>
                </a>
            </article>
        </div>
    </div>

    <a asp-page="/Temas" class="btn-casual">Ver todos los temas</a>
</section>
<section id="contact-section" class="d-flex flex-column align-items-center justify-content-center mt-5">
    <div class="cta-container w-75 rounded shadow p-5">
        <div class="col-6">
            <h2>¿Tienes algo que decir?</h2>
            <p class="mb-4">Comparte tus ideas, recomendaciones o simplemente cuéntanos qué música ha dejado huella en ti.</p>
            <a href="#" class="btn-casual-white">
                Contáctanos
            </a>
        </div>
    </div>
</section>