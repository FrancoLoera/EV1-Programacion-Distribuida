@page
@model EV1_Programación_Distribuida.Pages.HomeModel
@{
    Layout = "_Layout";
}
<section id="hero-section" class="d-flex flex-column align-items-center justify-content-center pb-5 mb-5">
    <div class="text-center">
        <img src="~/images/Fondo abstracto panorámico.png" class="rounded-3 shadow" style="width: 55%"/>
    </div>

    <div class="w-50 mt-4 d-flex flex-column align-items-center">
        <h1 class="align-self-center text-center">Tu música, en un solo Cassette.</h1>
        <p class="text-center">Explora historias, artistas, álbumes y géneros que han dejado huella en la música. Rebobina, descubre y encuentra algo nuevo para escuchar.</p>
        <a class="btn-casual"" asp-page="/Home">
            Explorar temas
        </a>
    </div>
</section>
<section id="feed-section" class="d-flex flex-column align-items-center justify-content-center rounded shadow p-5" style="background-color: #F8F8F8;">
    <div class="row">
        <div class="col-4">
            <a href="#">
                <div class="card" >
                    <div class="card-img-container">
                        <img class="card-img-top" src="~/images/Fondo abstracto.png">
                    </div>
                    <div class="card-body">
                        <h5 class="card-title">Conociendo al Electro Pop</h5>
                        <div class="card-meta d-flex mb-2">
                            <p class="mb-0"><i class="bi bi-person-fill ms-0 me-1"></i>Román</p>
                            <p class="mb-0" asp-page="/Home"><i class="bi bi-bookmark-fill ms-3 me-1"></i>Pop</p>
                        </div>
                        <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                    </div>
                </div>
            </a>
        </div>
        <div class="col-4">
            <div class="card" >
                <img class="card-img-top" src=".../100px180/" alt="Card image cap">
                <div class="card-body">
                    <h5 class="card-title">HOLA FRANCO</h5>
                    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                    <a asp-page="/Salsa" class="btn btn-primary">Go somewhere</a>
                </div>
            </div>
        </div>
        <div class="col-4">
            <div class="card" >
                <img class="card-img-top" src=".../100px180/" alt="Card image cap">
                <div class="card-body">
                    <h5 class="card-title">Card title</h5>
                    <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                    <a href="#" class="btn btn-primary">Go somewhere</a>
                </div>
            </div>
        </div>
    </div>
</section>