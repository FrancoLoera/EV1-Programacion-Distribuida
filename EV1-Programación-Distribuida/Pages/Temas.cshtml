@page
@model EV1_Programación_Distribuida.Pages.TemasModel
@{
}
<section id="hero-section" class="d-flex flex-column align-items-center justify-content-center pb-5 mb-5">
    <div class="text-center">
        <img src="~/images/Fondo abstracto oscuro panorámico.png" class="rounded-3 shadow" style="width: 55%" />
    </div>

    <div class="w-50 mt-4 d-flex flex-column align-items-center">
        <h1 class="align-self-center text-center">Explora por temas.</h1>
        <p class="text-center">Encuentra nuevas historias y perspectivas sobre tus artistas, álbumes y géneros favoritos. Explora cada tema y descubre contenido que conecte con lo que más te gusta de la música.</p>
    </div>
</section>
<section id="feed-section" class="d-flex flex-column align-items-center justify-content-center">
    <h2>Encuentra tu tema</h2>
    <p class="mb-4">Explora nuestras categorías y descubre contenido sobre los artistas, géneros, álbumes y estilos que más te interesan.</p>

    <!-- Primer fila feed -->
    <div class="row mb-4">
        <div class="col-4">
            <article>
                <a asp-page="Pop">
                    <div class="custom-card">
                        <div class="card-img-container">
                            <img src="~/images/Fondo Pop.png" style="width: 100%; background-color: #F8F8F8;">
                        </div>
                        <div class="custom-card-body d-flex flex-column justify-content-center align-items-center">
                            <h5 class="card-title music-title text-center">Pop</h5>

                            <p class="card-text text-center w-75">Melodías pegadizas y sonidos que han marcado generaciones.</p>
                        </div>
                    </div>
                </a>
            </article>
        </div>
        <div class="col-4">
            <article>
                <a asp-page="Salsa">
                    <div class="custom-card">
                        <div class="card-img-container">
                            <img src="~/images/Fondo Salsa.png" style="width: 100%; background-color: #F8F8F8;">
                        </div>
                        <div class="custom-card-body d-flex flex-column justify-content-center align-items-center">
                            <h5 class="card-title music-title text-center">Salsa</h5>
                        
                            <p class="card-text text-center w-75">Ritmos caribeños llenos de energía, baile y tradición.</p>
                        </div>
                    </div>
                </a>
            </article>
        </div>
        <div class="col-4">
            <article>
                <a asp-page="Rock">
                    <div class="custom-card">
                        <div class="card-img-container">
                            <img src="~/images/Fondo Rock.png" style="width: 100%; background-color: #F8F8F8;">
                        </div>
                        <div class="custom-card-body d-flex flex-column justify-content-center align-items-center">
                            <h5 class="card-title music-title text-center">Rock</h5>
                        
                            <p class="card-text text-center w-75">Guitarras, actitud y sonidos que transformaron la historia musical.</p>
                        </div>
                    </div>
                </a>
            </article>
        </div>
    </div>

    <!-- Segunda fila feed -->
    <div class="row mb-5">
        <div class="col-4">
            <article>
                <a>
                    <div class="custom-card">
                        <div class="card-img-container">
                            <img src="~/images/Fondo Reguetón.png" style="width: 100%; background-color: #F8F8F8;">
                        </div>
                        <div class="custom-card-body d-flex flex-column justify-content-center align-items-center">
                            <h5 class="card-title music-title text-center">Reguetón</h5>
                            
                            <p class="card-text text-center w-75">Ritmos urbanos nacidos de la mezcla de sonidos latinos y caribeños.</p>
                        </div>
                    </div>
                </a>
            </article>
        </div>
        <div class="col-4">
            <article>
                <a href="#">
                    <div class="custom-card">
                        <div class="card-img-container">
                            <img src="~/images/Fondo Jazz.png" style="width: 100%; background-color: #F8F8F8;">
                        </div>
                        <div class="custom-card-body d-flex flex-column justify-content-center align-items-center">
                            <h5 class="card-title music-title text-center">Jazz</h5>
                            
                            <p class="card-text text-center w-75">Improvisación, libertad y una evolución constante del sonido.</p>
                        </div>
                    </div>
                </a>
            </article>
        </div>
    </div>
</section>
<section id="contact-section" class="d-flex flex-column align-items-center justify-content-center mt-5">
    <div class="cta-container w-75 rounded shadow p-5">
        <div class="col-6">
            <h2>¿Tienes algo que decir?</h2>
            <p class="mb-4">Comparte tus ideas, recomendaciones o simplemente cuéntanos qué música ha dejado huella en ti.</p>
            <a href="#" class="btn-casual-white">
                Contáctanos
            </a>
        </div>
    </div>
</section>