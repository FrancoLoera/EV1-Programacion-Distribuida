@page
@model EV1_Programación_Distribuida.Pages.ContactoModel
@{
    ViewData["Title"] = "Contacto - Cassette";
}
<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="mb-4">
                <h1>Contáctanos</h1>
                <p>Nos gustaría conocer tu opinión. Déjanos un mensaje, comparte tus recomendaciones o cuéntanos qué música te apasiona.</p>
            </div>

            <form>
                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" class="form-control" placeholder="Escribe tu nombre">
                </div>

                <div class="mb-3">
                    <label class="form-label">Correo electrónico</label>
                    <input type="email" class="form-control" placeholder="correo@ejemplo.com">
                </div>

                <div class="mb-3">
                    <label class="form-label">Tema</label>
                    <select class="form-select">
                        <option selected>Selecciona un tema</option>
                        <option>Recomendación musical</option>
                        <option>Sugerencia</option>
                        <option>Colaboración</option>
                        <option>Otro</option>
                    </select>
                </div>

                <fieldset class="mb-3">
                    <legend class="fs-6">¿Qué tipo de contenido te interesa?</legend>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="contentType" id="artists">
                        <label class="form-check-label" for="artists">Artistas</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="contentType" id="albums">
                        <label class="form-check-label" for="albums">
                            Álbumes
                        </label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               name="contentType"
                               id="genres">
                        <label class="form-check-label" for="genres">
                            Géneros musicales
                        </label>
                    </div>
                </fieldset>

                <fieldset class="mb-3">
                    <legend class="fs-6">¿Qué te gustaría recibir?</legend>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="recommendations">
                        <label class="form-check-label" for="recommendations">Recomendaciones musicales</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="articles">
                        <label class="form-check-label" for="articles">Nuevos artículos</label>
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="events">
                        <label class="form-check-label" for="events">Eventos y conciertos</label>
                    </div>
                </fieldset>

                <div class="mb-4">
                    <label for="message" class="form-label">Mensaje</label>
                    <textarea id="message" class="form-control" rows="5" placeholder="Escribe tu mensaje..."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <a class="btn-casual">
                        Enviar mensaje
                    </a>

                    <a type="reset" class="btn-casual">
                        Limpiar
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>