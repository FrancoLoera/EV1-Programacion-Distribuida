                            <span class="member-name">Chávez Juárez Alan Alexis</span>
                        </td>

                        <td>
                            <span class="member-id">2064674</span>
                        </td>

                        <td>
                            <p class="member-description">
                                Apoyo en la creación de contenido y desarrollo
                                de las funcionalidades del proyecto.
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <img src="~/images/Nosotros/Foto Franco.png"
                                 alt="Franco"
                                 class="member-image">
                        </td>

                        <td>
                            <span class="member-name">Loera Alvarez Denis Franco</span>
                        </td>

                        <td>
                            <span class="member-id">2056827</span>
                        </td>

                        <td>
                            <p class="member-description">
                                Organización del proyecto, integración del código
                                y coordinación del trabajo del equipo.
                            </p>
                        </td>
                    </tr>

                </tbody>

            </table>

        </div>

    </div>

</div>