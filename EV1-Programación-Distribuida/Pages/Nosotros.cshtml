@page
@model EV1_Programación_Distribuida.Pages.NosotrosModel
@{
    ViewData["Title"] = "Nosotros";
}

<link rel="stylesheet" href="~/css/nosotros.css" />

<div class="team-page">

    <div class="container">

        <h1 class="team-title">Nosotros</h1>

        <p class="team-description">
            Somos un equipo de estudiantes de Tecnologías de la Información
            interesados en la música y el desarrollo de experiencias web.
            En este proyecto trabajamos juntos para crear Cassette,
            una página dedicada a explorar la historia y diversidad de la música.
        </p>

        <div class="table-responsive">

            <table class="team-table">

                <thead>
                    <tr>
                        <th>Fotografía</th>
                        <th>Nombre</th>
                        <th>Matrícula</th>
                        <th>Aportación al proyecto</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>
                        <td>
                            <img src="~/images/Nosotros/Foto Román.png"
                                 alt="Roman"
                                 class="member-image">
                        </td>

                        <td>
                            <span class="member-name">García Hernández Román Osvaldo</span>
                        </td>

                        <td>
                            <span class="member-id">1860130</span>
                        </td>

                        <td>
                            <p class="member-description">
                                Desarrollo y diseño de contenido para los artículos
                                relacionados con los géneros musicales.
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <img src="~/images/Nosotros/Foto Jimmy.jpeg"
                                 alt="Roberto"
                                 class="member-image">
                        </td>

                        <td>
                            <span class="member-name">Almaguer Garza Roberto</span>
                        </td>

                        <td>
                            <span class="member-id">1862977</span>
                        </td>

                        <td>
                            <p class="member-description">
                                Apoyo en el desarrollo y organización de las
                                diferentes secciones del proyecto.
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <img src="~/images/Nosotros/Foto Omar.jpeg"
                                 alt="Omar"
                                 class="member-image">
                        </td>

                        <td>
                            <span class="member-name">Garza López Omar de Jesús</span>
                        </td>

                        <td>
                            <span class="member-id">2097385</span>
                        </td>

                        <td>
                            <p class="member-description">
                                Desarrollo del artículo sobre el género musical
                                Salsa y apoyo en el diseño de la página.
                            </p>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <img src="~/images/Nosotros/Foto Alan.jpeg"
                                 alt="Alexis"
                                 class="member-image">
